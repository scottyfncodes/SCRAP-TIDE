{
  "name": "tidebreakers",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "check:visual": "node scripts/visual-check.mjs",
    "check:turn": "node scripts/turn-check.mjs",
    "sim": "node tests/sim/run-sims.mjs",
    "bot": "node tests/e2e/playtest-bot.mjs",
    "evidence:report": "node tests/sim/report.mjs",
    "evidence": "npm run build && npm run sim && npm run bot && npm run evidence:report",
    "check:hud": "node scripts/hud-shots.mjs dist hud-check"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
